# This plugin reads its configuration from Kimai's Symfony configuration,
# not from environment variables. No .env configuration is required to run it.
#
# The variables below only override defaults in docker-compose.yml, the local
# development environment. Copy to .env to customise. Never commit real
# credentials (spec §54).

# Kimai image tag. Defaults to the oldest supported version.
# Use 2.65.0 to verify against the newest supported version.
#KIMAI_TAG=apache-2.40.0

# Host port Kimai is published on.
#KIMAI_PORT=8001

# Local-only database credentials.
#DB_PASSWORD=kimai
#DB_ROOT_PASSWORD=kimai

# Initial Kimai super-admin created on first boot.
#ADMIN_MAIL=admin@kimai.local
#ADMIN_PASSWORD=changemeplease
